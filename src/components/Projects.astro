---
import { projectsData } from '../data/portfolioData';
---

<section id="projects" class="py-16 max-w-5xl mx-auto px-6 border-t border-zinc-800/60">
  <div class="flex flex-col space-y-8">
    <div>
      <h2 class="text-xs md:text-sm font-mono uppercase tracking-widest text-zinc-400 mb-2">Featured Projects</h2>
      <h3 class="text-3xl md:text-4xl font-bold text-zinc-100">Technical Highlights</h3>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {projectsData.map((project) => (
        <div class="group relative rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-7 hover:border-zinc-700 hover:bg-zinc-900/70 transition-all flex flex-col justify-between space-y-4">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono px-3 py-1 rounded bg-zinc-800 text-zinc-200 border border-zinc-700/50">
                {project.category}
              </span>
              {project.period && (
                <span class="text-xs md:text-sm font-mono text-zinc-400">{project.period}</span>
              )}
            </div>

            <div class="flex items-center justify-between mb-3">
              <h4 class="text-2xl font-bold text-zinc-100 group-hover:text-white transition-colors">
                {project.title}
              </h4>
            </div>

            <!-- Bullet points -->
            {project.bulletPoints && (
              <ul class="space-y-2.5 mb-5 text-sm md:text-base text-zinc-300 leading-relaxed">
                {project.bulletPoints.map((point) => (
                  <li class="flex items-start">
                    <span class="text-zinc-500 mr-2 font-mono">&bull;</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          <div>
            <!-- Links Section (Live Demo + GitHub) -->
            <div class="flex flex-wrap items-center gap-3 pt-3 mb-4">
              {project.liveUrl && (
                <a 
                  href={project.liveUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs md:text-sm font-mono px-3.5 py-2 rounded bg-emerald-950/60 text-emerald-400 border border-emerald-800/80 hover:bg-emerald-900/80 hover:border-emerald-600 transition-all"
                >
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  Live Demo &nearr;
                </a>
              )}

              {project.githubUrl && (
                <a 
                  href={project.githubUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs md:text-sm font-mono px-3.5 py-2 rounded bg-zinc-800/80 text-zinc-300 border border-zinc-700/80 hover:bg-zinc-700 hover:text-white transition-all"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                  Source Code
                </a>
              )}
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2 pt-3 border-t border-zinc-800/40">
              {project.tags.map((tag) => (
                <span class="text-xs font-mono text-zinc-400 bg-zinc-950 px-2.5 py-1 rounded border border-zinc-800">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
