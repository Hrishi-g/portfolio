---
import { skillsData } from '../data/portfolioData';
---

<section id="skills" class="py-16 max-w-5xl mx-auto px-6 border-t border-zinc-800/60">
  <div class="flex flex-col space-y-8">
    <div>
      <h2 class="text-xs md:text-sm font-mono uppercase tracking-widest text-zinc-400 mb-2">Technical Proficiency</h2>
      <h3 class="text-3xl md:text-4xl font-bold text-zinc-100">Skills & Architecture</h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {skillsData.map((category) => (
        <div class="rounded-xl border border-zinc-800/80 bg-zinc-900/30 p-6">
          <h4 class="text-sm md:text-base font-mono font-semibold text-zinc-200 uppercase tracking-wider mb-4 border-b border-zinc-800 pb-2">
            {category.category}
          </h4>
          <ul class="space-y-3">
            {category.skills.map((skill) => (
              <li class="flex items-center text-sm md:text-base text-zinc-300">
                <span class="w-2 h-2 rounded-full bg-zinc-500 mr-3 shrink-0"></span>
                <span>{typeof skill === 'string' ? skill : (skill as any).name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
