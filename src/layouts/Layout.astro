---
import { personalData } from '../data/portfolioData';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = `${personalData.name} - ${personalData.title}`,
	description = personalData.tagline 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Inter & JetBrains Mono Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#09090b] text-[#f4f4f5] font-sans antialiased min-h-screen selection:bg-zinc-800 selection:text-white">
		<!-- Subtle background grid -->
		<div class="fixed inset-0 -z-10 h-full w-full bg-[#09090b] bg-[radial-gradient(#27272a_1px,transparent_1px)] bg-[size:24px_24px]"></div>
		
		<slot />

		<style is:global>
			/* Custom subtle scrollbar */
			::-webkit-scrollbar {
				width: 8px;
			}
			::-webkit-scrollbar-track {
				background: #09090b;
			}
			::-webkit-scrollbar-thumb {
				background: #27272a;
				border-radius: 4px;
			}
			::-webkit-scrollbar-thumb:hover {
				background: #3f3f46;
			}
		</style>
	</body>
</html>
